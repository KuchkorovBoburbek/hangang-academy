{
  "name": "hangang-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --import tsx scripts/worker.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:topik": "node --import tsx scripts/import-topik.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backup": "node --import tsx scripts/backup.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib scripts tests *.ts *.mts *.json *.yaml",
    "db:solutions": "node --import tsx scripts/import-solutions.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
